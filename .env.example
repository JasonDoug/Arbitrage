# Copy to .env and adjust. All values have safe defaults.

# Venues to ingest: kalshi, polymarket, polymarket_us (placeholder), demo (offline fake data)
VENUES=kalshi,polymarket

# Web UI port on the host
WEB_PORT=8080

# Change this if the stack is reachable from other machines
POSTGRES_PASSWORD=predictarb

# Polling cadence (seconds)
CATALOG_INTERVAL_S=600
QUOTE_INTERVAL_S=20

# Polymarket lists thousands of thin markets; keep the top N by 24h volume
POLYMARKET_MAX_MARKETS=3000

# Kalshi lists ~200k open markets, mostly untraded strike ladders. Track only markets with
# 24h volume or open interest, top N by 24h dollar volume.
KALSHI_MAX_MARKETS=5000

# Fetch 30 days of hourly history for the top N markets (plus everything you watch)
BACKFILL_TOP_N=150
BACKFILL_DAYS=30

# Cross-venue matching and arbitrage
MATCH_INTERVAL_S=1800
MATCH_MIN_SCORE=0.5
ARB_MAX_QUOTE_AGE_S=180
# Polymarket taker fee rate by category (JSON). Unset = built-in defaults in backend/predictarb/arb.py.
# POLYMARKET_FEE_RATES={"Crypto": 0.072, "Economics": 0.05, "Culture": 0.05, "Weather": 0.05, "Other": 0.05, "Politics": 0.04, "Tech": 0.04, "Sports": 0.03}

# News: poll interval, optional feed override (JSON {"name": "url"}), retention
NEWS_INTERVAL_S=300
# NEWS_FEEDS={"BBC World": "https://feeds.bbci.co.uk/news/world/rss.xml"}
NEWS_RETENTION_DAYS=14

# AI (Sprint 2c). Never commit real keys. Any OpenAI-compatible endpoint works.
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
# Local server on this machine (llama.cpp/llama-swap, Ollama, LM Studio, vLLM). From inside
# Docker use host.docker.internal, e.g. Ollama: http://host.docker.internal:11434/v1
# LOCAL_LLM_URL=http://host.docker.internal:8081/v1
# LOCAL_LLM_MODEL=qwen2.5-14b-instruct
# Fallback order; first provider that answers wins
LLM_ORDER=openrouter,local
AI_SAMPLES=3
AI_MAX_CALLS_PER_DAY=400
# Suggested cross-venue pairs the LLM double-checks per matcher run (0 = off)
MATCH_LLM_PER_RUN=20
